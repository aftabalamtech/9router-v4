JWT_SECRET=${{secret(32)}}
INITIAL_PASSWORD=${{secret(32)}}
DATA_DIR=/data
# Optional. When set, PostgreSQL replaces SQLite as the primary database.
# DATABASE_URL=postgresql://user:password@host:5432/9router
PORT=20128
NODE_ENV=production
API_KEY_SECRET=${{secret(32)}}
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com
INSTANCE_NAME=9Router V3

# OPTIONAL: Outbound proxy for upstream provider connections.
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# OPTIONAL: Allow provider base URLs that resolve to loopback/private/link-local
# addresses. Disabled by default so a configured provider cannot be used to reach
# internal services or cloud metadata endpoints.
# Needed for self-hosted gateways: Ollama (http://localhost:11434), LM Studio,
# or a gateway on your LAN.
# true            = permit all private destinations (single-operator host only)
# host,CIDR list  = permit only those, e.g. localhost,192.168.1.0/24
# ALLOW_PRIVATE_EGRESS=true
