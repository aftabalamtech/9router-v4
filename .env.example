# ─── 9Router V3 production environment ─────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env` with secrets.
#   cp .env.example .env
#
# Legend: [REQUIRED] must be set (or have a safe default noted below).

# ── Application ──
NODE_ENV=production
PORT=3001                      # Container port. PaaS (Railway/Render) injects this automatically.
INSTANCE_NAME=9Router V3
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com
FRONTEND_ORIGIN=http://localhost:5177   # Only used for dev CORS display; production serves same-origin.

# ── Security and authentication ──
# [REQUIRED for first login] Shown at first dashboard login, then stored in DB.
INITIAL_PASSWORD=replace-with-a-secure-password
# Optional: auto-generated + persisted under DATA_DIR when unset. Set explicitly
# for multi-instance deployments so sessions survive restarts consistently.
JWT_SECRET=replace-with-a-random-secret
API_KEY_SECRET=replace-with-a-random-secret
AUTH_COOKIE_SECURE=false         # Set true when serving HTTPS directly (keep false behind a TLS proxy that terminates).
REQUIRE_API_KEY=false            # Set true to require an API key for /v1 traffic.
MACHINE_ID_SALT=endpoint-proxy-salt

# ── Database ──
# Default: SQLite at ${DATA_DIR}/db/data.sqlite. Mount a persistent volume at
# /data or SQLite data is LOST when the container is replaced.
DATA_DIR=/data
# Optional: set to use external PostgreSQL instead of SQLite.
# Format: postgresql://USER:PASSWORD@HOST:5432/9router
# DATABASE_URL=

# ── Outbound proxy for upstream provider connections (all optional) ──
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── Logging and runtime (all optional) ──
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_BATCH_SIZE=
# OBSERVABILITY_MAX_JSON_SIZE=

# ── Provider credentials ──
# Most providers are configured in the dashboard UI (OAuth/API keys stored in
# the database), NOT via env vars. Only these special cases use env:
# OPENAI_API_KEY=            # Optional fallback used by some flows
# AZURE_ENDPOINT=            # Azure OpenAI, when used
# AZURE_API_VERSION=
# AZURE_DEPLOYMENT=
# KIMI_CODING_OAUTH_CLIENT_ID=
