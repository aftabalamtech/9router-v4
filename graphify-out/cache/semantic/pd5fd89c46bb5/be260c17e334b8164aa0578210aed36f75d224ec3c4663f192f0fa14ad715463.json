{"nodes": [{"id": "frontend_public_providers_alicode_intl", "label": "Alibaba Intl Provider Icon Asset (alicode-intl.png)", "file_type": "image", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_public_providers_alicode_intl_alicloud_brand_mark", "label": "Alibaba Cloud Brand Mark (White Bracket Glyph)", "file_type": "concept", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_public_providers_alicode_intl_orange_brand_tile", "label": "Orange Brand Tile (#FF6A00)", "file_type": "concept", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_public_providers_alicode_intl_rounded_square_icon_pattern", "label": "Rounded Square Icon Tile Pattern", "file_type": "rationale", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mark is placed on a near-full-bleed rounded square with corner cut-outs at the glyph's three junctions, so the glyph reads as a cut-out of the tile rather than a logo floating on transparent background. This keeps the asset visually consistent with the other provider icons in the providers/ directory, which all use the same tile shape so the provider list renders as a uniform grid of equal-weight square badges."}, {"id": "frontend_public_providers_alicode_intl_brand_identifier_system", "label": "Brand Identifier System (Filename As Provider Id)", "file_type": "rationale", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The file has no embedded text; the provider identity is carried entirely by the filename 'alicode-intl', which doubles as the provider id and alias in the registry (Alibaba Intl, pointing at the international model-studio endpoint). Filename-as-id is the design decision: it lets one providers/ directory serve both the domestic and international Alibaba entries with no metadata sidecar, and lets the UI fall back to a textIcon ('ALi') when the image is missing."}, {"id": "frontend_public_providers_alicode_intl_regional_logo_variant", "label": "International Region Logo Variant (Glyph Identical To Domestic)", "file_type": "concept", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visually this file is pixel-equivalent in mark, tile color, and geometry to the domestic alicode.png in the same directory; the international region is signalled only by the '-intl' filename suffix, i.e. region differentiation is delegated to registry metadata (id, name, console/API-key URL) rather than to any change in the artwork."}, {"id": "frontend_public_providers_alicode_intl_high_contrast_mark", "label": "High Contrast Monochrome Mark (Single Accent Hue)", "file_type": "concept", "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one accent hue plus white is used, with no gradients, shadows, or outlines, so the badge stays legible at small list-item sizes and on both light and dark UI surfaces; the horizontal bar in the glyph doubles as the 'i' counter-form of the 'ALi' textIcon used elsewhere in the provider registry."}], "edges": [{"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_alicloud_brand_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_orange_brand_tile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_rounded_square_icon_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_brand_identifier_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_regional_logo_variant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl", "target": "frontend_public_providers_alicode_intl_high_contrast_mark", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"source": "frontend_public_providers_alicode_intl_alicloud_brand_mark", "target": "frontend_public_providers_alicode_intl_rounded_square_icon_pattern", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "frontend/public/providers/alicode-intl.png", "source_location": null, "weight": 1.0}, {"