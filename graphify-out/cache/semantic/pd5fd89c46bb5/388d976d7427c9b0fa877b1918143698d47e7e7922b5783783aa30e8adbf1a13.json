{"nodes": [{"id": "frontend_public_weavy", "label": "Weavy Logo Asset (weavy.jpeg)", "file_type": "image", "source_file": "frontend/public/weavy.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_public_weavy_brandmark", "label": "Weavy Bar-Glyph Brandmark", "file_type": "image", "source_file": "frontend/public/weavy.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brandmark is built from five axis-aligned solid rectangles on a white field: three tall bars in an upper row plus two shorter bars suspended below and between them. Pure geometry, no curves, no gradients, so the mark renders identically across light and dark surfaces and survives downscaling to list-row or favicon size where fine detail would disappear."}, {"id": "frontend_public_weavy_bar_chart_glyph", "label": "Bar Chart / Equalizer Bar Motif", "file_type": "concept", "source_file": "frontend/public/weavy.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unequal-height vertical bars are the classic visual shorthand for a histogram or audio equalizer, so the mark signals generative throughput and media pipelines without a single rendered example image \u2014 a deliberate choice for a provider whose outputs are pictures and video."}, {"id": "frontend_public_weavy_w_letterform", "label": "Abstract W Letterform Reading", "file_type": "concept", "source_file": "frontend/public/weavy.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_public_weavy_monochrome_flat_design", "label": "Flat Monochrome High-Contrast Logo Treatment", "file_type": "rationale", "source_file": "frontend/public/weavy.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "